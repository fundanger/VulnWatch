# Copy this to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── API server ────────────────────────────────────────────────────────────────
API_PORT=5000
API_SECRET=changeme-bearer-token   # Required for POST /api/scan, DELETE /api/profiles

# ── Email ─────────────────────────────────────────────────────────────────────
CVE_SENDER_EMAIL=you@gmail.com
CVE_SENDER_PASSWORD=xxxx xxxx xxxx xxxx   # Gmail App Password
CVE_RECIPIENT_EMAIL=team@example.com

# ── NVD API key (optional but recommended to avoid rate limits) ───────────────
NVD_API_KEY=

# ── Webhook / Slack ──────────────────────────────────────────────────────────
CVE_WEBHOOK_URL=
CVE_SLACK_WEBHOOK=

# ── Jira (optional) ──────────────────────────────────────────────────────────
JIRA_URL=https://myorg.atlassian.net
JIRA_USER=me@myorg.com
JIRA_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Bug

# ── ServiceNow (optional) ────────────────────────────────────────────────────
SNOW_INSTANCE=myorg.service-now.com
SNOW_USER=
SNOW_PASSWORD=
SNOW_CATEGORY=Security

# ── Scanner ──────────────────────────────────────────────────────────────────
SCAN_INTERVAL=3600   # seconds between headless scan cycles
